{
  "components": {
    "schemas": {
      "AnulowanieSPA": {
        "description": "Żądanie anulowania rezerwacji zabiegu SPA.\n\nReguła (docs/elevenlabs_agent_procedures.md): odwołanie >2h przed terminem\njest bezpłatne, <2h = 50% opłaty, chyba że powód jest medyczny.\n``appointment_datetime`` jest opcjonalny (kompatybilność ze starymi\nwywołaniami agenta), ale bez niego backend nie zna godziny zabiegu.",
        "properties": {
          "appointment_datetime": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Appointment Datetime"
          },
          "confirmation_id": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Confirmation Id",
            "type": "string"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "pl",
            "title": "Language"
          },
          "medical_release": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": false,
            "title": "Medical Release"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Reason"
          }
        },
        "required": [
          "confirmation_id"
        ],
        "title": "AnulowanieSPA",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Handoff": {
        "description": "Żądanie symulowanego przekazania rozmowy do człowieka (PoC).\n\nUżywane zamiast natywnego transfer_to_number, który wymaga realnej\ntelefonii (SIP/telefonia). W PoC agent wywołuje ten webhook, a backend\nloguje zdarzenie do konsoli i (opcjonalnie) wysyła alert na Telegram.",
        "properties": {
          "department": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "recepcja",
            "title": "Department"
          },
          "guest_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Guest Name"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "pl",
            "title": "Language"
          },
          "reason": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Reason"
          }
        },
        "title": "Handoff",
        "type": "object"
      },
      "PrzelozenieSPA": {
        "description": "Żądanie zmiany terminu zabiegu SPA (reschedule).",
        "properties": {
          "confirmation_id": {
            "maxLength": 40,
            "minLength": 1,
            "title": "Confirmation Id",
            "type": "string"
          },
          "guest_name": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Guest Name"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "pl",
            "title": "Language"
          },
          "new_date": {
            "title": "New Date",
            "type": "string"
          },
          "new_time": {
            "title": "New Time",
            "type": "string"
          },
          "service_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Service Name",
            "type": "string"
          }
        },
        "required": [
          "confirmation_id",
          "service_name",
          "new_date",
          "new_time"
        ],
        "title": "PrzelozenieSPA",
        "type": "object"
      },
      "RezerwacjaSPA": {
        "description": "Żądanie rezerwacji zabiegu SPA.\n\n``idempotency_key`` (opcjonalny) pozwala bezpiecznie ponowić to samo żądanie: backend\nzwróci wtedy oryginalne potwierdzenie zamiast odmowy \"slot zajęty\".",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "guest_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Guest Name",
            "type": "string"
          },
          "idempotency_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Idempotency Key"
          },
          "service_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Service Name",
            "type": "string"
          },
          "time": {
            "title": "Time",
            "type": "string"
          }
        },
        "required": [
          "service_name",
          "date",
          "time",
          "guest_name"
        ],
        "title": "RezerwacjaSPA",
        "type": "object"
      },
      "SprawdzeniePokoj": {
        "description": "Żądanie sprawdzenia dostępności pokoju.",
        "properties": {
          "check_in": {
            "title": "Check In",
            "type": "string"
          },
          "check_out": {
            "title": "Check Out",
            "type": "string"
          },
          "room_type": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Room Type",
            "type": "string"
          }
        },
        "required": [
          "room_type",
          "check_in",
          "check_out"
        ],
        "title": "SprawdzeniePokoj",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WysylkaSMS": {
        "description": "Żądanie wysłania podsumowania SMS/Telegram.",
        "properties": {
          "confirmation_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "",
            "title": "Confirmation Id"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "pl",
            "title": "Language"
          },
          "phone_number": {
            "maxLength": 32,
            "minLength": 3,
            "title": "Phone Number",
            "type": "string"
          },
          "summary_text": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Summary Text",
            "type": "string"
          }
        },
        "required": [
          "phone_number",
          "summary_text"
        ],
        "title": "WysylkaSMS",
        "type": "object"
      },
      "ZapytanieSPA": {
        "description": "Żądanie sprawdzenia dostępności zabiegu SPA.",
        "properties": {
          "date": {
            "title": "Date",
            "type": "string"
          },
          "service_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Service Name",
            "type": "string"
          }
        },
        "required": [
          "service_name",
          "date"
        ],
        "title": "ZapytanieSPA",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Mock backendu dla PoC Wirtualnego Recepcjonisty AI (ElevenLabs Agent).",
