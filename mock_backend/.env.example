# Configuration template for the mock backend. Copy to .env and fill in the values.
# NEVER commit .env (it holds secrets). This file is safe to commit: every value is empty or a default.

# ── Environment ──────────────────────────────────────────────────────────────
# dev  = start with warnings when secrets are missing (demo, local work)
# prod = refuse to start without ANNA_WEBHOOK_SECRET (and without a signing secret when events are on)
ANNA_ENV=dev

# ── Authentication of the agent's tool webhooks ─────────────────────────────
# Shared secret sent by ElevenLabs tool definitions as X-Webhook-Secret, or used as the HMAC key
# (X-Anna-Signature / X-Anna-Timestamp). Empty = auth disabled (demo only).
ANNA_WEBHOOK_SECRET=

# ── Persistence ──────────────────────────────────────────────────────────────
# Empty or ":memory:" = calendar in process memory (lost on restart).
# A file path = SQLite (created and migrated at startup). Run a single worker when using either.
ANNA_DB_PATH=

# ── Outbound integration events (CRM / n8n) ──────────────────────────────────
# Events are sent only when BOTH values are set. Each event is signed with ANNA_EVENTS_SIGNING_SECRET.
ANNA_EVENTS_WEBHOOK_URL=
ANNA_EVENTS_SIGNING_SECRET=

# ── Logs ─────────────────────────────────────────────────────────────────────
# demo = human-readable console blocks for the live demo; json = one JSON object per line (log shippers)
ANNA_LOG_FORMAT=demo
# 1 = demo blocks on the console, 0 = silent (warnings and errors are still printed)
ANNA_DEMO_LOGS=1

# ── Notifications (optional): without them SMS and handoff only go to the console ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins, comma-separated. "*" = all (credentials are then disabled).
CORS_ORIGINS=*
