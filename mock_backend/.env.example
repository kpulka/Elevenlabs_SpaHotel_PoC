# Wzór konfiguracji backendu — skopiuj do .env i uzupełnij wartościami.
# NIGDY nie commituj .env (zawiera sekrety). Ten plik jest bezpieczny (puste wartości).

# Powiadomienia (opcjonalne): bez nich SMS/handoff lecą tylko do konsoli.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dozwolone originy CORS, oddzielone przecinkami. "*" = wszystkie (wtedy credentials są wyłączone).
CORS_ORIGINS=*

# 1 = logi demo w konsoli (efekt prezentacji), 0 = cisza.
ANNA_DEMO_LOGS=1
