# Build context for the backend image (Podman/Docker). Keep it small: nothing here is needed at runtime.
# Used together with .containerignore (Podman prefers that file; the content is kept identical).
Dockerfile
.dockerignore
.containerignore
tunnel/
tests/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.env
.env.*
*.db
*.sqlite
*.sqlite3
*.log
*.exe
*.bak
