# Serwer: klucz API ElevenLabs (tylko po stronie serwera, nigdy nie trafia do klienta).
ELEVENLABS_API_KEY=
# ID agenta Anny używane przez /api/anna/signed-url (fallback w kodzie: agent_8401m0n03cggfgebhfh0cj96t7aj).
ELEVENLABS_AGENT_ID=
# Ten sam agent ID dla przeglądarki (widget <elevenlabs-convai>); musi być publiczny (NEXT_PUBLIC_*).
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Bazowy adres produkcyjny — używany przez sitemap.ts, robots.ts i metadataBase (fallback: https://bukowydwor.example).
NEXT_PUBLIC_SITE_URL=
