# Server-side only. Never prefix these with NEXT_PUBLIC_, and never commit real values.

# ElevenLabs API key, used by app/api/anna/signed-url to request signed conversation URLs.
ELEVENLABS_API_KEY=

# ElevenLabs ConvAI agent ID for Anna. Optional: falls back to the demo agent in
# app/api/anna/signed-url/route.ts when unset.
ELEVENLABS_AGENT_ID=
