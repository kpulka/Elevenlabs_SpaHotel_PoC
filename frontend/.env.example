# Server only: ElevenLabs API key used by /api/anna/signed-url. Never prefix with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=
# Server only: Anna agent id ("agent_..."). Required, there is no hardcoded fallback.
# If empty, the server falls back to NEXT_PUBLIC_ELEVENLABS_AGENT_ID (same value).
ELEVENLABS_AGENT_ID=
# Public: the same agent id, inlined into the browser bundle for the <elevenlabs-convai> widget.
# Not a secret. If missing or malformed, the voice widget is disabled and an error is logged.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
# Optional, comma-separated extra origins allowed to call /api/anna/signed-url
# (e.g. https://staging.example.test). localhost, 127.0.0.1 and the site's own origin are always allowed.
ALLOWED_ORIGINS=
# Default true: X-Forwarded-For / X-Real-IP identify the client for rate limiting (behind a proxy).
# Set to false when the app is exposed directly: the headers are then ignored (all clients share one budget).
TRUST_PROXY=
# Production base URL, used by sitemap.ts, robots.ts and metadataBase (fallback: https://bukowydwor.example).
NEXT_PUBLIC_SITE_URL=
